<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="laba1_Lavreniuk_FIT2_4.Views.StudentDetailPage"
             Title="Деталі студента">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label
            Text="Деталі студента"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label Text="ПІБ студента:" FontAttributes="Bold" />
        <Label Text="{Binding FullName, Mode=OneWay}"
               FontSize="18" />

        <Label Text="Група:" FontAttributes="Bold" />
        <Label Text="{Binding Group, Mode=OneWay}"
               FontSize="18" />

        <Label Text="Середній бал:" FontAttributes="Bold" />
        <Label Text="{Binding AverageScore, StringFormat='{0:F2}', Mode=OneWay}"
               FontSize="18" />

        <Entry
            Placeholder="Новий середній бал"
            Keyboard="Numeric"
            Text="{Binding EditedAverageScore, Mode=TwoWay}" />

        <Button
            Text="Зберегти зміни"
            Command="{Binding SaveCommand}" />

        <Button
            Text="Назад"
            Command="{Binding GoBackCommand}" />

    </VerticalStackLayout>

</ContentPage>
